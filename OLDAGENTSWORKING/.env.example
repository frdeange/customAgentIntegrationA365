# =========================================================================
# Azure OpenAI - required by both agent_basic.py and the upcoming
# autonomous-pattern agent.
# =========================================================================
# Full endpoint of your AOAI resource, e.g. https://my-aoai.openai.azure.com
# or AI Foundry v1 form: https://my-aoai.services.ai.azure.com/openai/v1
AZURE_OPENAI_ENDPOINT=
# Deployment name (NOT model name), e.g. gpt-4o
AZURE_OPENAI_DEPLOYMENT=
# Optional. For AI Foundry v1 endpoints use "preview".
AZURE_OPENAI_API_VERSION=2024-10-21

# =========================================================================
# Entra ID auth for Azure OpenAI
# =========================================================================
# For local dev just run `az login` and leave the three vars below empty.
# DefaultAzureCredential() will pick up the CLI session.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# =========================================================================
# Microsoft Agent 365 - autonomous-pattern PoC.
# These come from `a365 setup all --agent-name <name>` (writes them to
# a365.generated.config.json; we copy them here).
# =========================================================================
# Master switch: required for the SDK scopes (InvokeAgentScope, etc.) to
# actually create spans. Without this they are no-ops.
ENABLE_A365_OBSERVABILITY=true

# Exporter switch: "true" sends spans to the real Agent 365 ingestion
# endpoint (needs valid token + onboarded tenant). "false" falls back to
# the ConsoleSpanExporter — perfect for local verification.
ENABLE_A365_OBSERVABILITY_EXPORTER=true

# Provisioned IDs (filled in by `a365 setup all`)
AGENT365_TENANT_ID=
AGENT365_AGENT_ID=
AGENT365_BLUEPRINT_ID=
AGENT365_CLIENT_ID=
AGENT365_CLIENT_SECRET=
AGENT365_AGENT_NAME=
AGENT365_AGENT_DESCRIPTION=

# Token-flow strategy:
#   false -> 3-hop FMI starting from blueprint client secret (LOCAL DEV)
#   true  -> 3-hop FMI starting from Azure Managed Identity   (PRODUCTION)
AGENT365_USE_MANAGED_IDENTITY=false
