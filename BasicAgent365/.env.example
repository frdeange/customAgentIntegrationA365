# =========================================================================
# Azure OpenAI — required by both agent_basic.py and the upcoming
# Agent 365-integrated agent (agent_a365.py).
# =========================================================================
# Full endpoint of your AOAI resource, e.g.
#   https://my-aoai.openai.azure.com
# or AI Foundry v1 form:
#   https://my-aoai.services.ai.azure.com/openai/v1
AZURE_OPENAI_ENDPOINT=
# Deployment name (NOT model name), e.g. gpt-4o
AZURE_OPENAI_DEPLOYMENT=
# Optional. For AI Foundry v1 endpoints use "preview".
AZURE_OPENAI_API_VERSION=2024-10-21

# =========================================================================
# Entra ID auth for Azure OpenAI.
# For local dev just run `az login` and leave the three vars below empty.
# DefaultAzureCredential() will pick up the CLI session.
# =========================================================================
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# =========================================================================
# Microsoft Agent 365 — populated AFTER `a365 setup all --agent-name <name>`.
# Values come from a365.generated.config.json plus the blueprint client
# secret printed once during setup.
# =========================================================================
AGENT365_TENANT_ID=
AGENT365_AGENT_ID=
AGENT365_BLUEPRINT_ID=
AGENT365_CLIENT_ID=
AGENT365_CLIENT_SECRET=
AGENT365_AGENT_NAME=
AGENT365_AGENT_DESCRIPTION=
